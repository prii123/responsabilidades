# Copiar a .env y completar antes de "docker compose up".
# NUNCA commitear el archivo .env real (solo este .example).

# --- PostgreSQL ---
POSTGRES_DB=responsabilidades
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambia_esta_clave_super_segura
POSTGRES_PORT=5432

# Rol de conexión de PostgREST (sin privilegios propios, solo hace SET ROLE)
AUTHENTICATOR_PASSWORD=cambia_esta_clave_authenticator

# Rol de mantenimiento usado por el contenedor "scheduler" para marcar vencidos
MAINTENANCE_PASSWORD=cambia_esta_clave_maintenance

# Secreto simétrico (HS256) usado para firmar y validar los JWT del login local.
# Genera uno fuerte, por ejemplo: openssl rand -base64 48
# NOTA (Cognito): cuando exista el User Pool de Cognito, este secreto HS256 se
# reemplaza por la validación RS256 contra el JWKS de Cognito (ver backend/README.md,
# sección "Migrar a AWS Cognito").
APP_JWT_SECRET=cambia_este_secreto_jwt_bien_largo_y_aleatorio

# --- PostgREST ---
POSTGREST_PORT=3000

# --- Swagger UI (documentación interactiva de la API) ---
SWAGGER_PORT=8080

# --- Contraseñas de los usuarios de ejemplo cargados por el seed (08_seed.sql) ---
SEED_ADMIN_PASSWORD=admin12345
SEED_PROFESIONAL_PASSWORD=profesional12345
