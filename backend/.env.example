# Copiar a .env y completar antes de "docker compose up".
# NUNCA commitear el archivo .env real (solo este .example).

# --- PostgreSQL ---
POSTGRES_DB=responsabilidades
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambia_esta_clave_super_segura
POSTGRES_PORT=5432

# Rol de conexión de PostgREST (sin privilegios propios, solo hace SET ROLE)
AUTHENTICATOR_PASSWORD=cambia_esta_clave_authenticator

# Rol de mantenimiento usado por el contenedor "scheduler" para marcar vencidos
MAINTENANCE_PASSWORD=cambia_esta_clave_maintenance

# Rol de conexión directa (no vía PostgREST) usado por presign-service para
# mantener app.usuarios en sincronía con el User Pool de Cognito.
USER_SYNC_PASSWORD=cambia_esta_clave_user_sync

# --- AWS Cognito (autenticación, ver backend/db/README.md) ---
# PostgREST valida el JWT contra el JWKS (archivo estático jwks.json — no
# soporta fetch de una URL en vivo) y mapea "cognito:groups"[0] al rol de
# Postgres, así que los grupos del User Pool deben llamarse exactamente
# app_admin / app_profesional.
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=us-east-1

# --- PostgREST ---
POSTGREST_PORT=3000

# --- Swagger UI (documentación interactiva de la API) ---
SWAGGER_PORT=8080
