# Copiar a .env.local para desarrollo (Vite carga .env.local automáticamente).

# URL base de PostgREST (backend/). En docker-compose por defecto es el puerto 3000.
VITE_API_URL=http://localhost:3000

# URL base de presign-service/ (URLs firmadas de S3 para evidencias + admin de usuarios).
VITE_PRESIGN_URL=http://localhost:3001

# AWS Cognito (autenticación), ver backend/.env.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
