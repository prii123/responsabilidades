# Copiar a .env.

PORT=3001

# --- Cognito (autenticación de las rutas + administración de usuarios) ---
# Mismo User Pool/App Client que usa el frontend, ver backend/.env.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1

# Credenciales de un usuario IAM con permisos SOLO de administración de
# usuarios (Admin*) sobre ESTE User Pool (responsabilidades-cognito-admin,
# ver deploy/cognito-admin-iam-policy.json). Nunca credenciales de admin.
COGNITO_ACCESS_KEY_ID=
COGNITO_SECRET_ACCESS_KEY=

# --- S3 (firmar URLs de evidencias) ---
# Credenciales de un usuario IAM con permisos SOLO sobre el bucket de
# evidencias (s3:PutObject + s3:GetObject), nunca credenciales de admin.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# --- Postgres (rol app_user_sync, conexión directa, ver backend/db/init/sql/03_auth.sql) ---
# Este contenedor debe estar en la misma red docker que "db" del backend
# (ver docker-compose.yml: networks.default.name = backend_default).
DB_HOST=db
DB_PORT=5432
DB_NAME=responsabilidades
USER_SYNC_PASSWORD=

# Orígenes del frontend permitidos (separados por coma). Ej:
# http://localhost:5173,http://44.217.201.234
ALLOWED_ORIGINS=
