# Copiar a .env.

PORT=3001

# Debe ser EXACTAMENTE el mismo valor que APP_JWT_SECRET en backend/.env —
# así este servicio valida los mismos JWT que emite api.login.
APP_JWT_SECRET=

# Credenciales de un usuario IAM con permisos SOLO sobre el bucket de
# evidencias (s3:PutObject + s3:GetObject), nunca credenciales de admin.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# Orígenes del frontend permitidos (separados por coma). Ej:
# http://localhost:5173,http://44.217.201.234
ALLOWED_ORIGINS=
